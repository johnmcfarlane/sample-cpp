[settings]
arch=x86_64
build_type=Release
compiler=clang
compiler.cppstd=26
compiler.libcxx=libstdc++11
compiler.sanitizer=Fuzzer
compiler.version=23
os=Linux

[buildenv]
CXX=clang++
FUZZER_CXX_FLAGS=-fsanitize=fuzzer

[conf]
!&:tools.build:cxxflags=["-fsanitize=fuzzer-no-link"]
&:tools.build:cxxflags=["-fsanitize=fuzzer-no-link"]
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_STDLIB_MODULES_JSON": "/usr/local/lib64/libstdc++.modules.json", "ENABLE_FUZZER": "1"}

[tool_requires]
catch2/*:ninja/[~1]
fmt/*:cmake/[~4.4]
fmt/*:ninja/[~1]
