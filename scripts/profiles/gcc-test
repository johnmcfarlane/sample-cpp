[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.cppstd=26
compiler.libcxx=libstdc++11
compiler.sanitizer=AddressUndefinedBehavior
compiler.version=16
os=Linux

[buildenv]
CXX=g++

[conf]
!&:tools.build:cxxflags=["-D_FORTIFY_SOURCE=3", "-D_GLIBCXX_ASSERTIONS=1", "-fdiagnostics-color=always", "-fno-omit-frame-pointer", "-fno-sanitize-recover=all", "-fsanitize=address,undefined", "-march=native"]
&:tools.build:cxxflags=["-D_FORTIFY_SOURCE=3", "-D_GLIBCXX_ASSERTIONS=1", "-fdiagnostics-color=always", "-fno-omit-frame-pointer", "-fno-sanitize-recover=all", "-fsanitize=address,undefined", "-g", "-march=native", "-Wall", "-Werror", "-Wextra"]
&:tools.cmake.cmaketoolchain:extra_variables={"CMAKE_BUILD_TYPE": "Release"}

[tool_requires]
catch2/*:ninja/[~1]
fmt/*:cmake/[~4.4]
fmt/*:ninja/[~1]
