{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/install",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "build",
            "dependsOn": "install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/clean",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "clean all",
            "type": "shell",
            "command": "rm",
            "args": [
                "-r",
                "$BUILD_DIR_PARENT/*"
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/lint",
            "group": {
                "kind": "test",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "generate coverage report",
            "dependsOn": "test",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/report",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "test"
            },
        },
    ],
    "inputs": [
        {
            "id": "profile",
            "type": "pickString",
            "description": "Conan profile",
            "options": [
                "clang-asan",
                "clang-debug",
                "clang-fuzzer",
                "clang-release",
                "clang-tsan",
                "clang-tidy",
                "gcc-debug",
                "gcc-gcov",
                "gcc-release",
                "gcc-test"
            ]
        }
    ]
}
