{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Conan install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/conan/install",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "Conan build",
            "dependsOn": "Conan install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/conan/build",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "vcpkg install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/vcpkg/install",
            "args": [
                "${input:triplet}"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "vcpkg build",
            "dependsOn": "vcpkg install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/vcpkg/build",
            "args": [
                "${input:triplet}"
            ],
            "group": {
                "kind": "build"
            },
        },
        {
            "label": "Conan clean",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/clean",
            "args": [
                "conan/profiles/${input:profile}"
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "clean all",
            "type": "shell",
            "command": "rm",
            "args": [
                "-r",
                "$BUILD_DIR_PARENT/*"
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/lint",
            "group": {
                "kind": "test",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "generate coverage report",
            "dependsOn": "build",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/report",
            "args": [
                "${input:profile}"
            ],
            "group": {
                "kind": "test"
            },
        },
    ],
    "inputs": [
        {
            "id": "profile",
            "type": "pickString",
            "description": "Conan profile",
            "default": "gcc-release",
            "options": [
                "clang-asan",
                "clang-debug",
                "clang-fuzzer",
                "clang-release",
                "clang-tidy",
                "clang-tsan",
                "gcc-asan",
                "gcc-debug",
                "gcc-gcov",
                "gcc-release"
            ]
        },
        {
            "id": "triplet",
            "type": "pickString",
            "description": "vcpkg overlay triplet",
            "default": "gcc-release",
            "options": [
                "gcc-release"
            ]
        }
    ]
}
