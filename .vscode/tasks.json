{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/${input:package-manager}/install",
            "args": [
                "${input:config}"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "build",
            "dependsOn": "install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/${input:package-manager}/build",
            "args": [
                "${input:config}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/clean",
            "args": [
                "${input:package-manager}/config/${input:config}"
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "clean all",
            "type": "shell",
            "command": "rm",
            "args": [
                "-r",
                "$BUILD_DIR_PARENT/*"
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/lint",
            "group": {
                "kind": "test",
            },
            "presentation": {
                "clear": true,
            },
        },
        {
            "label": "generate coverage report",
            "dependsOn": "build",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/report",
            "args": [
                "${input:package-manager}",
                "${input:config}"
            ],
            "group": {
                "kind": "test"
            },
        },
    ],
    "inputs": [
        {
            "id": "package-manager",
            "type": "pickString",
            "description": "Package manager",
            "default": "conan",
            "options": [
                "conan",
                "vcpkg"
            ]
        },
        {
            "id": "config",
            "type": "pickString",
            "description": "Build configuration",
            "default": "gcc-release",
            "options": [
                "clang-asan",
                "clang-debug",
                "clang-fuzzer",
                "clang-release",
                "clang-tidy",
                "clang-tsan",
                "gcc-asan",
                "gcc-debug",
                "gcc-gcov",
                "gcc-release"
            ]
        }
    ]
}
